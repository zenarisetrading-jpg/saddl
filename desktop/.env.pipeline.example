# SP-API credentials (add these to your existing .env)
# DATABASE_URL is already configured in your environment

LWA_CLIENT_ID=amzn1.application-oa2-client.your_client_id_here
LWA_CLIENT_SECRET=amzn1.oa2-cs.v1.your_client_secret_here
LWA_REFRESH_TOKEN_UAE=Atzr|your_refresh_token_here

AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-west-1

MARKETPLACE_ID_UAE=A2VIGQ35RCS4UG
# Optional override (default is EU endpoint)
# SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
